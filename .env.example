# Copy to .env and fill in locally. Never commit .env.
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
# Optional: user access token for the real Meta Ads MCP (read-only), only if OAuth fails
META_ADS_ACCESS_TOKEN=
PYDANTIC_AI_NO_BANNER=1
# Optional: Muse Spark (open weights) on Baseten, used by --provider mixed
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Optional: a real ad account on a local install (Facebook Login for Business)
# The login configuration asks for ads_read and ads_management.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Where new paused ads point, and which Page they run as
META_PAGE_ID=
META_LINK_URL=
# Optional: limit the team to these ad sets (comma separated); recommended for a first run
META_ADSET_IDS=
# What counts as a result in insights (default mobile_app_install)
META_RESULT_ACTION=
# Days of history read on first connect (default 7)
META_LOOKBACK_DAYS=
