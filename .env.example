# Copy to .env and fill in locally. Never commit .env.
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
PYDANTIC_AI_NO_BANNER=1
# Optional: Muse Spark (open weights) on Baseten, used by --provider mixed
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Optional: a real ad account on a local install (Facebook Login for Business)
# The login configuration asks for ads_read, ads_management and ads_mcp_management, and the app
# has the "Create & manage ads with ads MCP server" use case.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Meta only redirects to HTTPS. Make a local certificate (mkcert localhost 127.0.0.1), keep it
# outside the repo, and add https://localhost:8000/api/meta/callback to Valid OAuth Redirect URIs.
PGT_TLS_CERT=
PGT_TLS_KEY=
# Where new paused ads point, and which Page they run as
META_PAGE_ID=
META_LINK_URL=
# Optional: limit the team to these ad sets (comma separated); recommended for a first run
META_ADSET_IDS=
# What counts as a result in insights (default mobile_app_install)
META_RESULT_ACTION=
# Days of history read on first connect (default 7)
META_LOOKBACK_DAYS=
# Reads go through Meta's Ads MCP, with the Graph API as the fallback. 0 reads through Graph only.
META_ADS_MCP=
